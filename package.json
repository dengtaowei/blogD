{
  "name": "linux-kernel-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "sync:dates": "node scripts/sync-article-dates.mjs",
    "sync:sidebar": "node scripts/generate-sidebar.mjs",
    "sync:sitemap": "node scripts/generate-sitemap.mjs",
    "docs:dev": "npm run sync:dates && npm run sync:sidebar && npm run sync:sitemap && vitepress dev docs",
    "docs:build": "npm run sync:dates && npm run sync:sidebar && npm run sync:sitemap && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy.ps1",
    "hooks:install": "bash ./scripts/install-hooks.sh"
  },
  "devDependencies": {
    "github-slugger": "^2.0.0",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.15.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
