#!/usr/bin/env bash
# 校验提交信息是否符合本项目规范：<类型>(<范围>): <简述>
# 见 .cursor/rules/commit-convention.mdc。安装：npm run hooks:install
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VALIDATE="$(dirname "$SCRIPT_DIR")/validate-commit-subject.sh"

msg_file="$1"

subject="$(grep -vE '^[[:space:]]*#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n1 || true)"

exec bash "$VALIDATE" "$subject"
